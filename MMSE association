## Script used for the protein abundance and MMSE association. Using CKB as an example. ##

library(sjPlot)
library(ggplot2)
library(ggpubr)
library(dplyr)

## Loading data ##

df <- "....."   ## add your file path ##
df <- read.csv(file = df, header = TRUE, sep = ",")
df2 <- as.data.frame(df)


## CKB - repeat for all proteins of interest, changing every CKB ##

lmModel1 <- lm(MMSE ~ CKB + Age + Gender + Eduy, data = df2)     ## not all variables are the same between cohorts, the replication cohort does not have education years (Eduy)##
summary(lmModel1)

CKB_MMSE <- plot_model(lmModel1, type = "eff", terms = c("CKB"), title = "", ci.level = 0.95,
                         show.data = TRUE, show.p = T, show.values = TRUE, line.size = 0) +
  labs(title = "",
       x = "CKB (log2)", 
       y = "MMSE") +
  geom_line(color = "#F15E6E", size = 2) +
  theme_classic(base_size = 16) +
  geom_label(check_overlap = TRUE, label.size = NA, label = paste("β = ", round(summary(lmModel1)$coefficients["CKB", "Estimate"], 2)), x = -1, y = 15, size = 4.5, hjust = 0, fill = "white", alpha = 0.5) +     ## change the number of decimals when needed, and the location of the label ##
  geom_label(check_overlap = TRUE, label.size = NA, label = paste("p = ", round(summary(lmModel1)$coefficients["CKB", "Pr(>|t|)"], 4)), x = -1, y = 12.5, size = 4.5, hjust = 0, fill = "white", alpha = 0.5) +   ## change the number of decimals when needed, and the location of the label ##
  theme(axis.title.x = element_text(size = 12, face = "plain", colour = "black", margin = margin(t = 5, r = 0, b = 0, l = 0)),
        axis.text.x = element_text(size = 12,colour = "black", margin = margin(t = 5, r = 0, b = 0, l = 0)),
        axis.text.y = element_text(size = 12, colour = "black", margin = margin(t = 0, r = 1, b = 5, l = 5)),
        title = element_text(size = 18, face = "plain"),
        legend.text = element_text(size = 18),
        legend.position = "none", 
        legend.key.size = unit(0.85,"cm"),
        panel.background=element_rect(colour="black"),
        plot.caption = element_text(hjust = 0),
        plot.caption.position = "panel") +
  scale_y_continuous(limits = c(12, 31))    ## also variable depending on the data for each protein ##

print(CKB_MMSE)

## After creating the plots for all proteins of interest, rearrange the plots into one single figure ##

ciliaprots_mmse <- ggpubr::ggarrange(SELENBP1_MMSE + rremove("ylab"),
                                     PRDX1_MMSE + rremove("ylab"),
                                     DDAH1_MMSE + rremove("ylab"),
                                     CKB_MMSE + rremove("ylab"),
                                     ENO1_MMSE + rremove("ylab"),
                                     PKM_MMSE + rremove("ylab"),
                                     YWHAE_MMSE + rremove("ylab"),
                                     HSPA8_MMSE + rremove("ylab"),
                                     TXN_MMSE + rremove("ylab"),
                                     labels = NULL,
                                     align = "hv", 
                                     nrow = 2, 
                                     ncol = 5, 
                                     font.label = list(size = 20, face = "bold", family = "Calibri"), vjust = 1.5, hjust = -0.2)

ciliaprots_mmse


ggsave(filename = "....tiff", plot = ciliaprots_mmse %>%     ## choose your own file name ##
         annotate_figure(ciliaprots_mmse, 
                         left = textGrob("MMSE score", rot = 90, vjust = 1, gp = gpar(cex = 1.3)),
                         top = textGrob("All individuals", rot = 0, vjust = 1.5, hjust = 11, gp = gpar(cex = 1.3))),
       dpi = 600, width = 15, height = 6.5, units = "in")
