## Script for the linear regression model of Figure 2C. CKB used as an example. Plots from figures 3 and 6A were created similarly, with changes in colors, group names, and variables adjusted ##

library(emmeans)
library(stringr)
library(ggplot2)
library(ggbeeswarm)
library(ggthemes)
library(ggpubr)

## Loading data ##

df <- ""   ## add your file path ##
df <- read.csv(file = df, header = TRUE, sep = ",")
df2 <- as.data.frame(df)

## Ordering x axis ##

df2[["Diagnosis"]]  <- factor(df2[["Diagnosis"]], c("NC", "MCI", "MCI+", "AD"))   ## diagnostic groups' names also change between cohorts ##


## CKB - repeat for all proteins of interest, changing every CKB ##

df3 = data.frame()
model3 = lm((CKB) ~ Diagnosis + Age + Gender + Eduy, df2)      ## not all variables are the same between cohorts, the replication cohort does not have education years (Eduy)##
pairs_result <- pairs(emmeans(model3, ~ "Diagnosis"), adjust ="BH")
df_contrasts3 = as.data.frame(pairs_result)
df3 = rbind(df3, df_contrasts3)
df3[c('group1', 'group2')] <- str_split_fixed(df3$contrast, ' - ', 2)
df3 <- df3[c('group1', 'group2', 'estimate', 'p.value')]
df3$p.adj.signif<-symnum(df3$p.value, corr = FALSE, na = FALSE, cutpoints = c(0, 0.0001, 0.001, 0.01, 0.05, 1), symbols = c("****", "***", "**", "*", "ns"))
df3$group1 <- sub(" ", "", df3$group1)
df3$group2 <- sub(" ", "", df3$group2)
df3$group1 <- sub("Diagnosis", "", df3$group1)
df3$group2 <- sub("Diagnosis", "", df3$group2)
df3$group1 <- sub("\\(", "", df3$group1)
df3$group2 <- sub("\\(", "", df3$group2)
df3$group1 <- sub("\\)", "", df3$group1)
df3$group2 <- sub("\\)", "", df3$group2)


CKB_plot <- ggplot(df2, aes(Diagnosis, CKB, color = Diagnosis)) +
  geom_boxplot(width = 0.5, 
               outlier.colour= NULL, outlier.shape= NA, notch=FALSE, lwd=0.5, color = "black") +
  geom_beeswarm(cex=1, size=2, show.legend=FALSE) +
  labs (title = "CKB",
        x = "Diagnosis",
        y = "Protein expression (log2)") +
  theme_few() +
  theme(axis.title = element_text(size = 12, face = "plain", colour = "black"),
        axis.text.x = element_text(size = 12,colour = "black"), 
        axis.text.y = element_text(size = 12, colour = "black", margin = margin(t = 0, r = 1, b = 5, l = 5)),
        title = element_text(size = 12, face = "bold"),
        legend.text = element_text(size = 12),
        legend.position = "none", #removes legend
        legend.key.size = unit(0.85,"cm"),
        panel.background=element_rect(colour="black"),
        plot.caption = element_text(hjust = 0),
        plot.caption.position = "panel",
        plot.title=element_text(hjust=0, vjust=0.5, face='plain')) +
  scale_color_manual(values=c('NC' = "#C4CB23", 'MCI' = "#4FB4CE", "MCI+" = "#074B89", "AD" = "#F15E6E")) +    ## colors were also altered between cohorts, depending on the groups' names ##
  stat_pvalue_manual(df3,
                     label = "{scales::pvalue(p.value)}",
                     y.position = 0.7, step.increase = 0.075,  ## y.position should change depending how big your y axis is ##
                     hide.ns = TRUE, 
                     tip.length=0.01,
                     label.size = 4)+
  expand_limits(y = 1.2)   ## also variable depending how big your y axis is ##

CKB_plot


