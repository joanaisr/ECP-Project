## Kruskal-Wallis analysis with BH correction performed to search for proteins with statistically significant differences between diagnostic groups (Figure 1A and Table S2) ##

(library(writexl)

df <- "...."  ## add your file path ##
df <- read.csv(file = df, header = TRUE, sep = ";")
df2 <- as.data.frame(df)

df2[["Diagnosis"]] <- factor(df2[["Diagnosis"]], c("NC","MCI","MCI+","AD"))
names(df2)[1] <- "Diagnosis"
groups <- rep(c("NC","MCI","MCI+","AD"))

kruskal_test_all_columns <- function(df2, group_column) {
  df2[[group_column]] <- as.factor(df2[[group_column]])
  variable_columns <- setdiff(names(df2), group_column)
  results <- list()
  for (col in variable_columns) {
    kruskal_test <- kruskal.test(df2[[col]] ~ df2[[group_column]])
    results[[col]] <- kruskal_test
  }
  return(results)
}

kruskal_results <- kruskal_test_all_columns(df2, "Diagnosis")

all_results <- data.frame(Variable = character(),
                          p_value = numeric(),
                          stringsAsFactors = FALSE)

for (col in names(kruskal_results)) {
  p_value <- kruskal_results[[col]]$p.value
  all_results <- rbind(all_results, data.frame(Variable = col, p_value = p_value))}

all_results$adj_p_value_BH <- p.adjust(all_results$p_value, method = "BH")


write_xlsx(all_results, "...........xlsx") ## add your new file name ##


